{
    "setup": {
        "seed": 42,
        "device": "cuda:0",
        "dtype": "torch.float32",
        "trainer_name": "sequential",
        "train": false,
        "test": true,
        "ckpt": true
    },

    "model": {
        "name": "gaot",
        "latent_tokens_size": [96, 96],
        "args": {
            "magno": {
                "coord_dim": 2,
                "radius": 0.033,
                "hidden_size": 64,
                "mlp_layers": 3,
                "lifting_channels": 64
            },
            "transformer": {
                "patch_size": 2,
                "hidden_size": 256
            }
        }
    },

    "dataset": {
        "backend": "netcdf",
        "name": "trl2d",
        "metaname": "benchmarking/trl2d_nc",
        "base_path": "/home/workspace/projects/transformer/GAOT/data/time_dep/",
        "use_metadata_stats": false,
        "use_sparse": false,
        "train_size": 72,
        "val_size": 9,
        "test_size": 9,
        "max_time_diff": 4,
        "time_step": 4,
        "coord_scaling": "global_scaling",
        "batch_size": 8,
        "num_workers": 4,
        "shuffle": true,
        "metric": "final_step",
        "predict_mode": "all",
        "stepper_mode": "time_der"
    },

    "optimizer": {
        "name": "adamw",
        "args": {
            "lr": 8e-4,
            "weight_decay": 1e-05,
            "epoch": 500,
            "loss_scale": 1.0,
            "eval_every_eps": 2,
            "scheduler": "mix",
            "max_lr": 1e-3,
            "min_lr": 1e-4,
            "final_lr": 5e-5
        }
    },

    "path": {
        "ckpt_path": ".ckpt/examples/time_dep/trl2d_netcdf_halfres.pt",
        "loss_path": ".loss/examples/time_dep/trl2d_netcdf_halfres.png",
        "result_path": ".results/examples/time_dep/trl2d_netcdf_halfres.png",
        "database_path": ".database/examples/time_dep/trl2d_netcdf_halfres.csv"
    },

    "wandb": {
        "enabled": true,
        "project": "gaot-trl2d_netcdf",
        "entity": "Zenithon-AI",
        "group": "trl2d_netcdf",
        "run_name": "GAOT_trl2d_halfres",
        "mode": "online",
        "tags": ["GAOT","TRL2D"],
        "watch_log": "all",
        "watch_freq": 100,
        "log_interval": 50,
        "save_code": true
  }
}
