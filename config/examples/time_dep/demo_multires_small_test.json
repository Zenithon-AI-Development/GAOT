{
    "setup": {
        "seed": 42,
        "device": "cuda:0",
        "dtype": "torch.float32",
        "trainer_name": "sequential",
        "train": false,
        "test": true,
        "ckpt": true
    },

    "model": {
        "name": "gaot",
        "latent_tokens_size": [64, 64],
        "use_conditional_norm": true,
        "args": {
            "magno": {
                "coord_dim": 2,
                "scales": [1],
                "use_scale_weights": true,
                "radius": 0.055,
                "hidden_size": 64,
                "mlp_layers": 3,
                "lifting_channels": 64
            },
            "transformer": {
                "patch_size": 2,
                "hidden_size": 256
            }
        }
    },

    "dataset": {
        "backend": "well_multires",
        "name": "demo",
        "metaname": "benchmarking/demo",
        "base_path": "/home/workspace/flash/ZEN_WELL_test/",
        "use_metadata_stats": false,
        "use_sparse": false,
        "train_size": 800,
        "val_size": 100,
        "test_size": 100,
        "max_time_diff": 4,
        "time_step": 4,
        "coord_scaling": "global_scaling",
        "batch_size": 2,
        "num_workers": 0,
        "shuffle": true,
        "metric": "final_step",
        "predict_mode": "autoregressive",
        "stepper_mode": "output"
    },

    "optimizer": {
        "name": "adamw",
        "args": {
            "lr": 8e-4,
            "weight_decay": 1e-05,
            "epoch": 500,
            "loss_scale": 1.0,
            "eval_every_eps": 2,
            "scheduler": "mix",
            "max_lr": 1e-3,
            "min_lr": 1e-4,
            "final_lr": 5e-5
        }
    },

    "path": {
        "ckpt_path": ".ckpt/examples/time_dep/demo/demo_multires_small_new_.pt",
        "loss_path": ".loss/examples/time_dep/demo/multires/demo_multires_small.png",
        "result_path": ".results/examples/time_dep/demo/multires/demo_multires_small.png",
        "database_path": ".database/examples/time_dep/demo/multires/demo_multires_small.csv"
    },

    "wandb": {
        "enabled": false,
        "project": "gaot-demo",
        "entity": "Zenithon-AI",
        "group": "demo_multires_small",
        "run_name": "GAOT_demo_multires_eval",
        "mode": "offline",
        "tags": ["GAOT","DEMO","EVAL"],
        "watch_log": "all",
        "watch_freq": 10,
        "log_interval": 5,
        "save_code": true
  }
}
